+def _stage06_preimport(args):
+    """Check the finite bootstrap closure without importing application modules."""
+    environment = PROJECT.parents[3]
+    prefix = environment/'review/stage06_external_drs_passage/v01'
+    launch_path = Path(args.stage06_launch)
+    require(launch_path.is_absolute() and launch_path == launch_path.absolute()
+        and any(launch_path.is_relative_to(prefix/name)
+            for name in ('owner_terminal_runs', 'offline_attempts')),
+        'stage06_preimport_launch_path')
+    launch_raw = _read(launch_path)
+    launch = json.loads(launch_raw)
+    reference = launch.get('code_manifest_ref')
+    require(type(reference) is dict and set(reference) == {'path', 'sha256', 'size_bytes'},
+        'stage06_preimport_manifest_ref')
+    manifest_path = Path(reference['path'])
+    require(manifest_path == prefix/'source_manifest.json', 'stage06_preimport_manifest_path')
+    raw = _read(manifest_path)
+    require(len(raw) == reference['size_bytes']
+        and hashlib.sha256(raw).hexdigest() == reference['sha256'],
+        'stage06_preimport_manifest_hash')
+    manifest = json.loads(raw)
+    require(manifest.get('environment_root') == str(environment)
+        and manifest.get('candidate_root') == str(PROJECT)
+        and type(manifest.get('files')) is list, 'stage06_preimport_root_binding')
+    pins = {row['path']: row for row in manifest['files']}
+    require(len(pins) == len(manifest['files']), 'stage06_preimport_duplicate_path')
+    for relative in ('app/__init__.py', 'config/__init__.py',
+            'config/stage06_bootstrap.py', 'app/ordinary_entry.py'):
+        path = PROJECT/relative
+        reference = pins.get(str(path))
+        require(type(reference) is dict, 'stage06_preimport_missing_pin')
+        raw = _read(path)
+        require(len(raw) == reference['size_bytes']
+            and hashlib.sha256(raw).hexdigest() == reference['sha256'],
+            'stage06_preimport_source_hash')
+    return launch
+
+
+def _stage06_failure(args, error):
+    """Emit a bounded bootstrap failure without loading any legacy reporter."""
+    code = error.args[0] if isinstance(error, ValueError) and error.args else ''
+    if type(code) is not str or not re.fullmatch('[A-Za-z0-9_:./-]{1,160}', code):
+        code = 'stage06_native_entry_failure'
+    print(json.dumps(dict(kind='ENTRY_FAILURE', role=getattr(args, 'stage06_role', None),
+        session=getattr(args, 'stage06_session', None), failure=dict(code=code,
+            error_class=type(error).__name__)), sort_keys=True), flush=True)
+    return 2
+
